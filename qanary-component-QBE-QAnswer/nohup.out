                            oa:start ?start;
                            oa:end ?end
                      ]
    ].
    ?annotationId oa:hasBody ?hasBody ;
                  oa:annotatedBy ?annotatedBy ;
                  oa:annotatedAt ?annotatedAt .
                  OPTIONAL {
                      ?annotationId qa:score ?score .
                  }
}
