PREFIX qa: <http://www.wdaqua.eu/qa#>

SELECT *
FROM ?graph
WHERE {
    ?annotationId rdf:type qa:AnnotationOfInstance .
    ?annotationId oa:hasTarget [
                    a oa:SpecificResource;
                      oa:hasSource ?hasSource;
                      oa:hasSelector [
